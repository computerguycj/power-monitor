# Copy to .env and fill in. Never commit .env.

# IP of the Kasa plug. Find it with: kasa discover
PLUG_HOST=192.168.88.X

# ntfy topic. Anyone who knows it can read and send your alerts,
# so make it long and random.
NTFY_TOPIC=replace-with-a-long-random-string

# Optional: also relay alerts to this email address.
# ntfy.sh only emails addresses verified on an ntfy account, and the
# request must carry that account's access token (NTFY_TOKEN).
# Leave both blank for phone push only.
NTFY_EMAIL=
NTFY_TOKEN=

# Optional overrides
# NTFY_SERVER=https://ntfy.sh
# PING_HOST=1.1.1.1
# POLL_SECONDS=30
# FAIL_THRESHOLD=2
